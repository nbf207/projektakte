# Copy to .env in your Compose directory.
# Ready out of the box for a local/LAN start without external services.
# Optional integrations below can be enabled anytime later—just edit .env and run `docker compose up -d`.

# ==============================================================================
# 1. Minimal Start (Local / LAN)
# ==============================================================================
# Set DEMO_MODE=1 only if you want synthetic demo data instead of your own database.
DEMO_MODE=0
DEBUG=0

# Local HTTP defaults for quick first-run testing on localhost / private LAN.
# For any public or internet-facing host, switch to HTTPS=1 and ALLOW_INSECURE_HTTP=0 below.
HTTPS=0
ALLOW_INSECURE_HTTP=1

# Leave SECRET_KEY empty to auto-generate a persistent key at /data/.secret-key on first start.
# Explicit SECRET_KEY or SECRET_KEY_FILE always takes precedence.
SECRET_KEY=
# SECRET_KEY_FILE=/run/secrets/django-key

# Hostname (without scheme or port) and allowed host headers.
# Always keep 127.0.0.1 in ALLOWED_HOSTS for the container healthcheck.
PUBLIC_HOST=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_PORT=8010

# Automatic pre-migration SQLite snapshot + migration on container start.
# Set AUTO_MIGRATE=0 if you manage migrations manually.
AUTO_MIGRATE=1
PRE_MIGRATE_KEEP=5

# Native Python runs read DATA_DIR directly (in Docker, DATA_DIR is always /data).
DATA_DIR=./data

# --- Localization, Currency & Timezone ---
# Fallback language when the browser sends no matching Accept-Language header ("de" or "en").
# Browsers with English or German Accept-Language are detected automatically, and users can switch anytime in Account settings.
DEFAULT_LANGUAGE=de
# Default 3-letter ISO-4217 currency code (e.g. EUR, USD, GBP, CHF, CAD, AUD). Can also be overridden per account.
DEFAULT_CURRENCY=EUR
# IANA timezone (e.g. Europe/Berlin, UTC, America/New_York). Falls back to TZ if unset.
TIME_ZONE=Europe/Berlin

# ==============================================================================
# 2. Public HTTPS / Reverse Proxy (Recommended for Production)
# ==============================================================================
# Uncomment and adjust when terminating TLS at Caddy, Nginx, Traefik, or Cloudflare Tunnel:
# HTTPS=1
# ALLOW_INSECURE_HTTP=0
# PUBLIC_HOST=projektakte.example.com
# ALLOWED_HOSTS=projektakte.example.com,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://projektakte.example.com
# TRUSTED_PROXY=<proxy-ip-or-dns-name>
CSRF_TRUSTED_ORIGINS=
TRUSTED_PROXY=

# ==============================================================================
# 3. Optional Integrations (Enable Anytime Later Without Reinstalling)
# ==============================================================================

# --- Google Gemini AI (auto-extract receipts, voice memos, and quick captures) ---
# Disabled by default until you set AI_ENABLED=1 and add your own GEMINI_API_KEY.
# Works immediately once enabled (built-in default token rates apply when left at 0).
# Supported GEMINI_MODEL values: gemini-3.5-flash-lite, gemini-3.8-flash
AI_ENABLED=0
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# GEMINI_API_KEY_FILE=/run/secrets/gemini-key
# Shared monthly budget guardrails (USD per million tokens; 0 uses built-in model defaults).
AI_MONTHLY_WARN=1
AI_MONTHLY_LIMIT=2
AI_INPUT_USD_PER_M=0
AI_OUTPUT_USD_PER_M=0
AI_REQUEST_RESERVE=0.05
# Original-file extraction limit per document (1–12 MiB).
GEMINI_ORIGINAL_MAX_MB=8
AI_VISION_INPUT_RESERVE=1100000

# --- Optional Floating Feedback Widget (disabled by default for self-hosters) ---
FEEDBACK_WIDGET_ENABLED=0

# --- Paperless-ngx (optional document archive & OCR) ---
# Use an address reachable from the worker container. Leave empty to disable.
PAPERLESS_URL=
PAPERLESS_TOKEN=
# PAPERLESS_TOKEN_FILE=/run/secrets/paperless-token
PAPERLESS_API_VERSION=9

# --- IMAP Mail Import (optional receipt inbox) ---
# Leave empty to disable mail polling.
MAIL_IMAP_HOST=
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_ALLOWED_SENDER=
MAIL_CAPTURE_USER=

# --- Upload & PDF Export Limits (tune for available RAM) ---
MAX_PHOTO_MB=20
MAX_DOCUMENT_MB=50
MAX_IMAGE_PIXELS=20000000
PDF_MAX_ENTRIES=500
PDF_MAX_PHOTOS=200
PDF_MAX_TEXT_CHARS=500000
