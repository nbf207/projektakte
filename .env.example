# Copy to .env in the Compose directory. Safe loopback-only demo defaults.
# For production: DEMO_MODE=0, DEBUG=0, HTTPS=1, and a strong SECRET_KEY.
DEMO_MODE=1
DEBUG=0
HTTPS=0
SECRET_KEY=
# Optional alternative, mounted inside the container (never set both):
# SECRET_KEY_FILE=/run/secrets/django-key

# Use your own hostname, HTTPS origin and actual proxy IP or DNS name in live mode.
# PUBLIC_HOST is a hostname only, without scheme or port.
PUBLIC_HOST=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
TRUSTED_PROXY=

# Host path persisted by Compose; the in-container DATA_DIR is always /data.
# Native Python runs read DATA_DIR directly.
APP_DATA_DIR=./data
DATA_DIR=./data
APP_PORT=8010
# Optional override for Compose env_file; provide it via shell or --env-file.
# PROJEKTAKTE_ENV_FILE=.env
PYTHON_IMAGE=python:3.14.10-slim-trixie

# Optional Paperless-ngx connection. Use an address reachable from the worker.
PAPERLESS_URL=
PAPERLESS_TOKEN=
# PAPERLESS_TOKEN_FILE=/run/secrets/paperless-token
PAPERLESS_API_VERSION=9

# The demo uses simulated adapters. In live mode set 0 until this is configured.
AI_ENABLED=1
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# GEMINI_API_KEY_FILE=/run/secrets/gemini-key
# Budgets are shared across the database. Prices are USD per million tokens.
AI_MONTHLY_WARN=1
AI_MONTHLY_LIMIT=2
AI_INPUT_USD_PER_M=0
AI_OUTPUT_USD_PER_M=0
AI_REQUEST_RESERVE=0.05
# Original-file extraction per document, 1–12 MiB; validate reserve for model in use.
GEMINI_ORIGINAL_MAX_MB=8
AI_VISION_INPUT_RESERVE=1100000

# Optional IMAP import. Leave empty to disable. Use your own allowed sender/account.
MAIL_IMAP_HOST=
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_ALLOWED_SENDER=
MAIL_CAPTURE_USER=

# Upload and PDF-export bounds. Tune for available RAM.
MAX_PHOTO_MB=20
MAX_DOCUMENT_MB=50
MAX_IMAGE_PIXELS=20000000
PDF_MAX_ENTRIES=500
PDF_MAX_PHOTOS=200
PDF_MAX_TEXT_CHARS=500000
